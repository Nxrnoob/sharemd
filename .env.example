# Local dev (offline, zero config): file DB next to the repo.
DATABASE_URL=local.db

# ---- Vercel + Turso (production) ----
# 1. Install CLI:      curl -sSfL https://get.tur.so/install.sh | sh
# 2. Sign up / login:  turso auth signup   (or: turso auth login)
# 3. Create the DB:    turso db create sharemd
# 4. Read its URL:     turso db show sharemd --url        -> TURSO_DATABASE_URL
# 5. Mint a token:     turso db tokens create sharemd     -> TURSO_AUTH_TOKEN
# 6. Set both as Vercel project env vars (Production + Preview),
#    then run migrations against Turso:
#      TURSO_DATABASE_URL=libsql://... TURSO_AUTH_TOKEN=... bun run db:migrate
# 7. One-time copy of local rows:  bun scripts/migrate-to-turso.mjs
#    (needs the same two env vars; never touches local.db)
#TURSO_DATABASE_URL=libsql://sharemd-<user>.turso.io
#TURSO_AUTH_TOKEN=
